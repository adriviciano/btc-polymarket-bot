# Polymarket API Credentials (required)
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_api_passphrase_here
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_FUNDER=

# Bot Configuration
# Maximum combined cost to trigger arbitrage (e.g., 0.991 means buy if UP + DOWN < $0.991)
TARGET_PAIR_COST=0.991

# Number of shares to buy per trade
ORDER_SIZE=5

# --- Predictor bot: LAG signal (paper) -------------------------------------
# Only the LAG signal showed real edge. Tuned from the paper sample:
ENABLE_RSI=false        # RSI had no edge -> LAG-only
LAG_MIN_BPS=8           # BTC must have moved >= N bps from open (<8 is net -EV)
LAG_MAX_PRICE=0.75      # don't buy a favorite above this ask (>=0.78 was a loser)
# Entry window in seconds-to-close: bet only when LAG_MIN_TIME_LEFT <= left <= LAG_TRIGGER_S.
# The paper sample showed <40s-left bets won just 43% (avg -1.40/trade) -> floor at 45s.
LAG_TRIGGER_S=120       # start considering a lag bet when <= N s remain
LAG_MIN_TIME_LEFT=45    # ...but never bet with fewer than N s left (-EV tail)
# Edge-scaled stake: cheaper favorite = bigger book lag = bigger edge, so stake more.
# Scales linearly from LAG_ORDER_SIZE (at LAG_MAX_PRICE) to LAG_ORDER_SIZE_MAX (at
# LAG_CHEAP_REF). The paper sample: asks <0.60 returned +1.9..+2.4/trade vs +0.22 at
# 0.70-0.73 -> route capital to the cheap, high-edge fills. Leave the two equal for a
# flat stake.
LAG_ORDER_SIZE=8        # base LAG stake (shares) at the price ceiling
LAG_ORDER_SIZE_MAX=25   # max LAG stake (shares) for the cheapest favorites
LAG_CHEAP_REF=0.58      # ask at/below which the max stake applies
# Self-tuning ceiling: learns realized-vs-quoted slippage and lowers the EFFECTIVE
# LAG_MAX_PRICE
LAG_ADAPTIVE=true       # set false to use a fixed LAG_MAX_PRICE
LAG_SLIP_ALPHA=0.1      # EMA weight on the newest fill (higher = adapts faster)
LAG_MAX_PRICE_FLOOR=0.55  # never tighten the effective ceiling below this
PREDICTOR_STATE=predictor_state.json  # where the learned slippage is persisted

# Hang watchdog: force-exit (so systemd restarts) if a tick stalls past N seconds.
# Fixes the multi-hour silent gaps caused by a frozen CLOB socket. 0 disables.
WATCHDOG_TIMEOUT=120

# Order type / time-in-force:
# - FOK = Fill-or-Kill (all-or-nothing, avoids leaving one leg open)
# - FAK = Fill-and-Kill (partial allowed, remainder cancelled)
# - GTC = Good-Til-Cancelled (can leave one leg open)
ORDER_TYPE=FOK

# Simulation mode (true = no real orders, false = live trading)
DRY_RUN=true

# Extra diagnostic logging (true = more logs)
VERBOSE=false

# Simulated balance for dry run mode
SIM_BALANCE=100

# Minimum seconds between executions (prevents repeated rapid-fire executions)
COOLDOWN_SECONDS=10

# Optional: Market slug (leave empty for auto-discovery)
POLYMARKET_MARKET_SLUG=

# Optional: Use CLOB WebSockets (Market channel) instead of polling
# true = realtime order book updates via WSS, false = HTTP polling
USE_WSS=false

# Optional: WebSocket base URL (defaults to Polymarket CLOB subscriptions)
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com
